{
  "name": "harness-forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Recursive harness optimization with the model frozen. A miniature, runnable version of Harness^2 (Google Research).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "serve": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "loop": "tsx scripts/run-loop.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
